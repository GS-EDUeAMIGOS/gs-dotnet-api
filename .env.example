# ==============================================================================
# ViaCidadã Ouvidoria API (.NET 8) - Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# NUNCA versione senhas reais! Copie este arquivo para .env (ignorado pelo Git)
# ou configure via dotnet user-secrets / variáveis de ambiente do sistema.

# ------------------------------------------------------------------------------
# Banco de Dados Oracle FIAP (Mesmas credenciais do ecossistema ViaCidadã)
# ------------------------------------------------------------------------------
ORACLE_DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
ORACLE_DATA_SOURCE=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521))(CONNECT_DATA=(SID=ORCL)))
ORACLE_DB_USERNAME=rmXXXXXX
ORACLE_DB_PASSWORD=sua_senha_aqui

# ConnectionString padrão do ASP.NET Core (opcional se ORACLE_DB_USERNAME e ORACLE_DB_PASSWORD estiverem preenchidos)
ConnectionStrings__OracleConnection=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle.fiap.com.br)(PORT=1521))(CONNECT_DATA=(SID=ORCL)));User Id=rmXXXXXX;Password=sua_senha_aqui;
